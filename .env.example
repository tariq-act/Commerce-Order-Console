# Copy this file to .env.local for local development.
# SQLite filesystem path, not a connection URL; do not prefix with file:.
# Relative paths resolve from the project root when commands run there.
DATABASE_PATH=./data/commerce.db

# For deployment, set DATABASE_PATH to an absolute file path on persistent,
# writable storage. This is a server-only variable; never use NEXT_PUBLIC_.
# Next.js selects NODE_ENV through its dev/build/start commands.
