{
  "name": "commerce-order-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "npm run build && node --import tsx --test tests/integration/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx src/db/migrate.ts",
    "db:seed": "node --import tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:inspect": "node --import tsx src/db/inspect.ts",
    "db:verify": "node --import tsx src/db/verify.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@next/env": "^16.4.6",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "prettier": "3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
